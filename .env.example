# SuvidhaPay Docker Compose environment template
# Copy this file to one of the environment-specific variants if needed.
# Root env files are for Docker Compose orchestration.
# App-local runtime .env files live in SuvidhaPay-api/ and SuvidhaPay-web/.

# Compose project and exposed ports
COMPOSE_PROJECT_NAME=suvidhapay
WEB_PORT=3000
API_PORT=3001
DB_PORT=5432
ADMINER_PORT=8080

# Shared application runtime
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
JWT_SECRET=change-me
JWT_EXPIRY=7d
JWT_REFRESH_EXPIRY=30d
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
LOG_LEVEL=info
ENABLE_API_DOCS=true

# Frontend build-time variables (used during docker image build)
DB_NAME=suvidhapay
DB_USER=postgres
DB_PASSWORD=postgres

# Frontend build-time variables (used during docker image build)
VITE_API_BASE_URL=/api
VITE_APP_NAME=SuvidhaPay
VITE_APP_VERSION=1.0.0
VITE_ENV=development
VITE_DEBUG=false
VITE_LOG_LEVEL=info
