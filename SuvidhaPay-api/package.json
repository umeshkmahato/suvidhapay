{
  "name": "suvidhapay-api",
  "version": "1.0.0",
  "description": "Municipal Collection Management System - Backend API",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "dev": "nodemon src/index.js",
    "start": "node src/index.js",
    "start:docker": "npm run migrate && npm run seed && npm start",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "migrate": "node database/migrations/run.js",
    "seed": "node database/seeds/run.js",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest --coverage",
    "test:watch": "jest --watch"
  },
  "keywords": [
    "municipal",
    "collection",
    "management",
    "suvidhapay"
  ],
  "author": "SuvidhaPay Team",
  "license": "MIT",
  "dependencies": {
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "joi": "^17.11.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.10.0",
    "pg": "^8.10.0",
    "uuid": "^14.0.2"
  },
  "devDependencies": {
    "eslint": "^8.54.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-plugin-import": "^2.29.0",
    "jest": "^30.5.2",
    "nodemon": "^1.14.10",
    "supertest": "^6.3.3"
  }
}
